# Configure-time embedding; no JSON parser or file I/O in render callbacks.
set(locale_codes en zh-Hans zh-Hant ja)
set(panel_catalog "({")
foreach(lang IN LISTS locale_codes)
 set(file "${CMAKE_CURRENT_SOURCE_DIR}/i18n/${lang}.json")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
 file(READ "${file}" json_${lang})
 string(REGEX REPLACE "^﻿" "" json_${lang} "${json_${lang}}")
 string(APPEND panel_catalog "\"${lang}\":${json_${lang}},")
endforeach()
string(REGEX REPLACE ",$" "" panel_catalog "${panel_catalog}")
string(APPEND panel_catalog "})")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/i18n-catalog.jsxinc" "${panel_catalog}")
set(keys "")
foreach(lang IN LISTS locale_codes)
 string(JSON count LENGTH "${json_${lang}}")
 math(EXPR last "${count}-1")
 foreach(index RANGE 0 ${last})
  string(JSON key MEMBER "${json_${lang}}" ${index})
  list(APPEND keys "${key}")
 endforeach()
endforeach()
list(REMOVE_DUPLICATES keys)
list(SORT keys)
set(catalog "static constexpr Entry entries[]={\n")
foreach(key IN LISTS keys)
 string(APPEND catalog "{\"${key}\",{")
 foreach(lang IN LISTS locale_codes)
  string(JSON value ERROR_VARIABLE missing GET "${json_${lang}}" "${key}")
  if(missing)
   set(value "")
  endif()
  string(JSON kind ERROR_VARIABLE missing TYPE "${json_${lang}}" "${key}")
  if(NOT missing AND NOT kind STREQUAL "STRING")
   message(FATAL_ERROR "Translation must be a string: ${lang}/${key}")
  endif()
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(APPEND catalog "\"${value}\",")
 endforeach()
 string(APPEND catalog "}},\n")
endforeach()
string(APPEND catalog "};\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/catalog.inc" "${catalog}")
add_library(dither_i18n STATIC i18n/i18n.cpp)
target_include_directories(dither_i18n PUBLIC i18n/include PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
set_target_properties(dither_i18n PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
 target_compile_options(dither_i18n PUBLIC /utf-8)
endif()
