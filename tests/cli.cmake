foreach(case IN ITEMS "0001;1;1" "0121;2;2" "0241;17;13" "0361;64;64")
 list(GET case 0 name)
 list(GET case 1 width)
 list(GET case 2 height)
 execute_process(COMMAND "${CLI}" "${GOLDEN}/${name}.in.rgba" "${WORK}/cli-${name}.rgba" "${width}" "${height}" 1 none 77 0 1 0 RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "CLI failed for ${name}")
 endif()
 execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${WORK}/cli-${name}.rgba" "${GOLDEN}/${name}.out.rgba" RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "CLI differs from TypeScript fixture ${name}")
 endif()
endforeach()
execute_process(COMMAND "${CLI}" "${GOLDEN}/0001.in.rgba" "${WORK}/invalid.rgba" 2 2 RESULT_VARIABLE result)
if(result EQUAL 0)
 message(FATAL_ERROR "CLI accepted truncated input")
endif()
