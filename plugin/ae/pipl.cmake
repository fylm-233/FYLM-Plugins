set(definitions "")
if(MFR)
 list(APPEND definitions /DDITHER_ENABLE_MFR=1)
endif()
execute_process(COMMAND "${COMPILER}" /nologo ${definitions} /EP /TC "/I${SDK}/Headers" "${SOURCE}" OUTPUT_FILE "${OUTPUT}.rr" RESULT_VARIABLE r)
if(NOT r EQUAL 0)
 message(FATAL_ERROR "PiPL preprocess failed: ${r}")
endif()
execute_process(COMMAND "${SDK}/Resources/PiPLTool.exe" "${OUTPUT}.rr" "${OUTPUT}.rrc" RESULT_VARIABLE r)
if(NOT r EQUAL 0)
 message(FATAL_ERROR "PiPLTool failed: ${r}")
endif()
execute_process(COMMAND "${COMPILER}" /nologo /DMSWindows /EP /TC "${OUTPUT}.rrc" OUTPUT_FILE "${OUTPUT}" RESULT_VARIABLE r)
if(NOT r EQUAL 0)
 message(FATAL_ERROR "PiPL RC preprocess failed: ${r}")
endif()
