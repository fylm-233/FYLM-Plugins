file(MAKE_DIRECTORY "${WORK}")
if(EXISTS "${WORK}/Assets")
 message(FATAL_ERROR "Isolation fixture must not contain Assets")
endif()
file(COPY_FILE "${PLUGIN}" "${WORK}/FYLM_ShaderGlass.aex" ONLY_IF_DIFFERENT)
execute_process(COMMAND "${TEST}" "${WORK}/FYLM_ShaderGlass.aex" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Embedded AEX without assets failed: ${output} ${error}")
endif()
message(STATUS "Native AEX in an Assets-free directory: ${output}")
