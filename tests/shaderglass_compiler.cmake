file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/cycle.slangp" "#reference \"cycle.slangp\"\n")
file(WRITE "${WORK}/missing.slangp" "shaders = 1\nshader0 = absent.slang\n")
file(WRITE "${WORK}/oversized.slangp" "shaders = 33\n")
file(WRITE "${WORK}/lut.slangp" "shaders = 1\nshader0 = absent.slang\ntextures = \"LUT\"\nLUT = missing.png\n")
foreach(name IN ITEMS cycle missing oversized lut)
 execute_process(COMMAND "${COMPILER}" "${WORK}/${name}.slangp" "${WORK}/${name}.fylmsg" RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 15)
 if(result EQUAL 0 OR error STREQUAL "")
  message(FATAL_ERROR "Invalid ${name} preset accepted or failed without a diagnostic")
 endif()
endforeach()
file(TO_CMAKE_PATH "${SOURCE}/assets/ShaderGlass/crt/crt-geom.slangp" geom)
file(WRITE "${WORK}/reference.slangp" "#reference \"${geom}\"\nCRTgamma = 3.1\n")
execute_process(COMMAND "${COMPILER}" "${WORK}/reference.slangp" "${WORK}/reference.fylmsg" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 0 OR NOT output MATCHES "CRTgamma.*default=3.1")
 message(FATAL_ERROR "Reference/override failed: ${output} ${error}")
endif()
message(STATUS "ShaderGlass reference/overrides and cycle/missing/LUT/pass-limit diagnostics passed")
file(MAKE_DIRECTORY "${WORK}/中文 空格")
file(COPY_FILE "${SOURCE}/assets/ShaderGlass/fylm/identity.slang" "${WORK}/中文 空格/原图.slang")
file(READ "${WORK}/中文 空格/原图.slang" unicode_shader)
string(REPLACE "#version 450" "#version 450\n#include \"参数.inc\"" unicode_shader "${unicode_shader}")
file(WRITE "${WORK}/中文 空格/原图.slang" "${unicode_shader}")
file(WRITE "${WORK}/中文 空格/参数.inc" "#define FYLM_UNICODE_INCLUDE 1\n")
file(WRITE "${WORK}/中文 空格/预设.slangp" "shaders = 1\nshader0 = \"原图.slang\"\n")
execute_process(COMMAND "${COMPILER}" "${WORK}/中文 空格/预设.slangp" "${WORK}/中文 空格/编译.fylmsg" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Unicode source/path failed: ${output} ${error}")
endif()
